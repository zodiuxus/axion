# Axion default sdkconfig overrides.
# Copy to sdkconfig.defaults in a fresh checkout; the build system will
# merge these into sdkconfig on the first `idf.py build`.

# Target chip
CONFIG_IDF_TARGET="esp32s3"

# FreeRTOS - 1000 Hz tick keeps pdMS_TO_TICKS timeouts fine-grained (the UART
# and state mutexes use millisecond timeouts). The previous comment claimed
# mutex semantics depend on the tick rate; they do not.
CONFIG_FREERTOS_HZ=1000

# Partition table - give us a bit of NVS for the calibration_store bitfield.
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# NVS - used by calibration_store to persist the first-run / calibration flags.
CONFIG_NVS_ENCRYPTION=n

# Logging - default to INFO, can be bumped to DEBUG per-file in code.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y

# UART - keep the driver ISR in IRAM so a modem burst is not lost while the
# flash cache is disabled during an NVS commit. (The previous symbol name,
# CONFIG_UART_ISR_IRAM_SAFE, does not exist and was silently ignored.)
CONFIG_UART_ISR_IN_IRAM=y

# I2C - the new master driver (driver/i2c_master.h), used by I2Cdev / MPU6050
# and the MAX30102 task. No legacy i2c.h API is used.
CONFIG_I2C_ENABLE_DEBUG_LOG=n

# Bluetooth is off. Wi-Fi cannot be disabled here: CONFIG_ESP_WIFI_ENABLED is a
# hidden symbol forced on for Wi-Fi-capable SoCs, and nothing in the application
# references esp_wifi_*, so the blob is not linked. To keep Wi-Fi out of the
# build entirely, trim the component list in the top-level CMakeLists.txt.
CONFIG_BT_ENABLED=n
