#pragma once
/**
 * secrets.h.example - TEMPLATE for secrets.h
 *
 * Axion needs a small number of device-specific secrets (SIM PIN, alert
 * phone numbers). The real values are kept in `secrets.h`, which is
 * intentionally NOT tracked by git (see `.gitignore`).
 *
 * Setup:
 *   1. Copy this file to `secrets.h` (same directory).
 *   2. Edit `secrets.h` and replace the placeholder values.
 *   3. NEVER commit `secrets.h`. NEVER paste real PINs into this example.
 *
 * If `secrets.h` is missing, the build will fail with a clear #error.
 */

#ifndef AXION_SECRETS_H_EXAMPLE
#define AXION_SECRETS_H_EXAMPLE

/* ---- SIM PIN ---------------------------------------------------------- */
/* 4–8 digit PIN for the SIM card inserted into the A7670E.
 * Leave as an empty string "" if your SIM has no PIN enabled. */
#define SIM_PIN             "0000"

/* ---- Alert recipients ------------------------------------------------- */
/* Listed in priority order. The monitor task texts each non-empty slot
 * in order, so ALERT_PHONE_1 is always contacted first.
 *
 * ALERT_PHONE_1 (primary): the local emergency number. Many European
 *   countries now accept SMS to 112 (the EU-wide emergency number).
 *   Set this to "112" or your local equivalent.
 * ALERT_PHONE_2 (backup): a personal contact (caretaker, family member).
 *   Use E.164 format, e.g. "+38971234567". Leave as "" to disable. */
#define ALERT_PHONE_1       "112"
#define ALERT_PHONE_2       "+000000000000"

/* ---- Carrier (MCC+MNC) ----------------------------------------------- */
/* The PLMN code the modem PREFERS to register on, used as the
 * expected-response substring for `AT+COPS?`. Format is MCC (3 digits)
 * immediately followed by MNC (2-3 digits), no separator.
 *   e.g. 29403  ->  North Macedonia (294) + A1 (03)
 *        26002  ->  Poland (260) + T-Mobile (02)
 *        23410  ->  UK (234) + O2 (10)
 *
 * This is the FACTORY DEFAULT - on first boot it's copied into NVS
 * (key "carrier"). After that NVS is the source of truth, so the
 * carrier can be changed at runtime without reflashing. To revert to
 * the secrets.h value, clear the NVS entry (factory reset path).
 *
 * The PLMN is a PREFERENCE, not a requirement: modem_setup_task tries
 * manual selection (COPS=1,2) first; if that fails - e.g. the user is
 * abroad - it falls back to automatic (COPS=0) and accepts either
 * stat=1 (home) or stat=5 (roaming) from CEREG. This lets the device
 * send SMS to 112 from any registered EU network.
 *
 * Leave as "" to skip manual selection entirely and always go
 * automatic. */
#define CARRIER_MCCMNC      "29403"

/* ---- APN (optional) -------------------------------------------------- */
/* If your carrier needs a specific APN for data, set it here. Leave ""
 * to skip the CGDCONT configuration and rely on the default.
 *
 * Like CARRIER_MCCMNC, these are factory defaults - on first boot
 * they're copied into NVS and NVS becomes the source of truth. */
#define APN_NAME            ""
#define APN_USER            ""
#define APN_PASS            ""

#endif /* AXION_SECRETS_H_EXAMPLE */
