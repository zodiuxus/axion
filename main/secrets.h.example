#pragma once
/**
 * secrets.h.example - TEMPLATE for secrets.h (gitignored).
 *
 * Copy to secrets.h and fill in real values; never commit secrets.h.
 */

#ifndef AXION_SECRETS_H_EXAMPLE
#define AXION_SECRETS_H_EXAMPLE

/* 4-8 digit SIM PIN, "" if the SIM has no PIN. */
#define SIM_PIN             "0000"

/* Alert recipients in priority order (the monitor texts each non-empty
 * slot). ALERT_PHONE_1: local emergency number (e.g. "112", SMS-capable,
 * no E.164 prefix). ALERT_PHONE_2: personal backup, E.164 format
 * (e.g. "+38971234567"), "" to disable. */
#define ALERT_PHONE_1       "112"
#define ALERT_PHONE_2       "+000000000000"

/* Preferred PLMN (MCC+MNC, e.g. 29402 = MK/A1). Factory default only -
 * seeded into NVS on first boot, afterwards NVS wins. "" = always
 * automatic selection; a rejected manual selection also falls back to
 * automatic (covers roaming). */
#define CARRIER_MCCMNC      "29402"

/* APN (optional; "" = skip CGDCONT). Also NVS-seeded factory defaults. */
#define APN_NAME            ""
#define APN_USER            ""
#define APN_PASS            ""

#endif /* AXION_SECRETS_H_EXAMPLE */
